{
  "manifestVersion": "1.0",
  "identity": {
    "driver": "modbus_rtu",
    "version": "1.0.0",
    "protocol": "modbus_rtu",
    "displayName": "Modbus RTU/TCP Driver",
    "abiVersion": 2,
    "dynamicCapabilities": true
  },
  "config": { "type": "object", "additionalProperties": true },
  "capabilities": { "cancel": true, "push": false, "streaming": false },
  "tools": [],
  "stateFields": [],
  "sources": [
    {
      "id": "telemetry",
      "kind": "poll",
      "fields": [],
      "intervalMs": 1000,
      "minIntervalMs": 200,
      "demandOnly": false,
      "health": true
    }
  ],
  "resources": [],
  "placement": { "mode": "runtime" },
  "limits": { "maxConcurrentJobs": 1, "maxCallsPerMin": 60 }
}
