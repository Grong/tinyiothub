{
  "id": "inspection",
  "version": 1,
  "title": "设备巡检",
  "description": "按计划读取设备属性与告警，异常时保留证据供人工复核。",
  "definition": {
    "objective": "按计划巡检选中设备：读取属性与告警，记录证据，并在发现异常时说明需要人工处理的原因。",
    "trigger": {
      "type": "cron",
      "trigger_id": "inspection-hourly",
      "expression": "0 * * * *"
    },
    "deviceSelector": {},
    "sourceSelector": {
      "sources": [
        "telemetry"
      ]
    },
    "toolIds": [
      "get_thing",
      "read_properties",
      "alarm_list"
    ],
    "skillRefs": [
      "device-management"
    ],
    "requiredCapabilities": [
      "text"
    ],
    "approvalPolicy": {},
    "evidencePolicy": {
      "required": true,
      "kinds": [
        "property_snapshot",
        "event"
      ]
    }
  }
}
